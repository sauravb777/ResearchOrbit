# --- v79 LLM provider ---
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# --- arXiv / retrieval ---
MAX_SOURCES=30
MAX_EVIDENCE=40
RESULTS_PER_QUERY=8
V79_RESULTS_PER_QUERY=10
# v79.11 fast discovery (arXiv allows ~1 request / 3 s, so we ask for BIG pages instead of more requests)
V80_ARXIV_PAGE_SIZE=60          # records per arXiv request (max 100)
V80_CANDIDATE_RESERVOIR=240     # candidates kept and BM25-ranked before the Top-15 cut
V80_MIN_STABILITY_SECONDS=20    # earliest the Top-15-stable early stop may fire
V80_LLM_RERANK_POOL=40          # shortlist size sent to the single LLM listwise reranker
V80_RETRIEVAL_LLM_WORKERS=4     # parallel LLM shards in triage / rerank / verification
# v79.12 deep reading / report depth
V81_LENS_PASSES=true            # 5 parallel section-aware specialist reading lenses per paper (false = previous 2-stage reader)
V81_LENS_MAX_CHARS=90000        # max paper characters sent to any one lens
V81_MAX_REPORT_TOPICS=4         # production fast path caps the report at four substantive sections
V79_MAX_PAPERS=15
V79_MAX_CANDIDATES=15
V79_MAX_READ_PASSES=2
V79_DISCOVERY_BUDGET_SECONDS=300
V79_GAP_SEARCH_BUDGET_SECONDS=90
ENABLE_V79_ARCHITECTURE=true
V79_FAIL_CLOSED=true
MAX_ITERATIONS=2
FETCH_FULL_TEXT=true
MAX_FULL_TEXT_SOURCES=30
FULL_TEXT_MAX_CHARS=400000
MAX_PDF_BYTES=25000000
MAX_PDF_PAGES=250

# Autonomous evidence corpus. This is NOT a user-facing paper-count control.
CORPUS_SAFETY_CEILING=30
AUTO_SELECTION_MAX=15
# Automatic RED papers must have verified readable full text before report generation.
REQUIRE_VERIFIED_DEEP_REPORT=true
REQUIRE_RESEARCH_GRADE_REPORT=true
ENABLE_ADAPTIVE_GAP_SEARCH=false
ADAPTIVE_GAP_MAX_QUERIES=4

# --- Deep reading ---
ENABLE_DEEP_READ=true

# Optional embedding reranking. The research corpus remains LLM/heuristic-aware
# even when this is disabled.
ENABLE_SEMANTIC_RERANK=false
SEMANTIC_RERANK_MODEL=all-MiniLM-L6-v2

# --- Claim verification / storage ---
VERIFY_MAX_NEW_SOURCES=6
DATA_DIR=data
REPORTS_DIR=reports
DB_PATH=data/researchpilot.db

# --- API deployment ---
RESEARCHPILOT_API_KEY=
RESEARCHPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
RESEARCHPILOT_JOB_DB=data/jobs.db
RESEARCHPILOT_JOB_WORKERS=2
RESEARCHPILOT_MAX_UPLOAD_BYTES=15728640
RESEARCHPILOT_MAX_UPLOAD_FILES=16
RESEARCHPILOT_MAX_TOTAL_UPLOAD_BYTES=67108864

# Discovery is arXiv-only (rate-limited; the client throttles itself).

# Fast complete-paper reading/report path
PAPER_READ_CONCURRENCY=5
FAST_DEEP_READ=true
FAST_DEEP_READ_MAX_CHARS=140000
FAST_DEEP_READ_CHUNK_CHARS=105000
FAST_DEEP_READ_OVERLAP_CHARS=6000
FAST_REPORT_PIPELINE=true
# REPORT_JOB_TIMEOUT_SECONDS is intentionally unused for report generation; jobs run until completion or user cancellation.

# v82 universal fast research hot path
UNIVERSAL_FAST_REPORT=true
COMPACT_REPORT_REASONING=false
RESEARCH_RUN_DEADLINE_SECONDS=540
FAST_SKIP_RELEVANCE_ENRICHMENT=true
BEAST_WHOLE_PAPER_TIER=M
BEAST_WHOLE_PAPER_TOKENS=6000

# Performance-safe report generation. These defaults keep a four-paper run
# usable on Groq's free 8K TPM tier. Paid users can increase them after measuring.
PERFORMANCE_INPUT_CHARS_PER_PAPER=18000
PERFORMANCE_READER_MAX_TOKENS=2600
PERFORMANCE_COUNCIL_CARD_CHARS=5200
PERFORMANCE_COUNCIL_MAX_TOKENS=3000
PERFORMANCE_WRITER_MAX_TOKENS=2600
PERFORMANCE_WRITER_PASSAGES=4

PERFORMANCE_MAX_REPORT_TOPICS=7
GROQ_TPM_HINT=8000

# Quality-first production: preserve deep paper interrogation and adaptive report synthesis.
QUALITY_FIRST=true
QUALITY_DEEP_READ_REGION_CHARS=24000
QUALITY_DEEP_READ_BUNDLE_CHARS=70000
QUALITY_DEEP_READ_BUNDLE_TOKENS=4200
QUALITY_DEEP_READ_INTEGRATION_TOKENS=6200
QUALITY_DEEP_READ_MAX_BUNDLES=12
QUALITY_REPORT_MIN_TOPICS=4
QUALITY_REPORT_MAX_TOPICS=6
QUALITY_REPORT_WRITER_CHARS=22000
